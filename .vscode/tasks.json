{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "venv\\Scripts\\activate; pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm run dev -- --mode dev",
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "venv\\Scripts\\activate; python manage.py runserver",
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Project",
      "dependsOn": [
        "Start Frontend",
        "Start Backend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}