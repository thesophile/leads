{
  "openapi": "3.0.0",
  "info": {
    "title": "Leads — External Orders API",
    "version": "1.0.0",
    "description": "Read-only endpoint for external systems (ERP / accounting / reporting) to fetch orders. Order numbers are reported with an \"ORD-\" prefix. The delivery date and sales person are internal fields, manually maintained; neither is shown to clients or included in the order form / proposal / PDF."
  },
  "servers": [
    { "url": "https://newleads.programersapps.com" }
  ],
  "security": [
    { "apiKey": [] }
  ],
  "paths": {
    "/api/external/orders/": {
      "get": {
        "operationId": "listOrders",
        "summary": "Paginated list of orders",
        "description": "Returns orders newest-first, across all companies, paginated via page/page_size.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 }
          },
          {
            "name": "company",
            "in": "query",
            "required": false,
            "description": "Case-insensitive substring filter on the company name.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated order feed.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderPage" }
              }
            }
          },
          "403": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "detail": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key set via the EXTERNAL_ORDERS_API_KEY environment variable. Send as 'Authorization: Bearer <key>' or the 'X-API-Key' header."
      }
    },
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "example": "ORD-P2026-0001",
            "description": "Order number with the internal id prefixed by 'ORD-'."
          },
          "company": { "type": "string", "description": "Company that placed the order." },
          "order_value": { "type": "string", "description": "Order net value (after discount), as stored." },
          "order_date": { "type": "string", "format": "date", "example": "2026-09-25" },
          "delivery_date": {
            "type": "string",
            "format": "date",
            "example": "2026-10-30",
            "description": "Internal expected delivery date; empty when not set."
          },
          "sales_person": {
            "type": "string",
            "description": "Telecaller who changed the lead status to 'Quotation Requested'."
          }
        }
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" },
          "page": { "type": "integer" },
          "page_size": { "type": "integer" },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } }
        }
      }
    }
  }
}